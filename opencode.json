{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "node-debugger": {
      "type": "local",
      "command": ["npx", "-y", "@jaenster/node-debugger-mcp"],
      "enabled": true
    }
  },
  "lsp": {
    "typescript": {
      "command": ["./node_modules/.bin/typescript-language-server", "--stdio"],
      "extensions": [".ts"],
      "initialization": {
        "tsserver": { "path": "node_modules/typescript-js/lib/tsserver.js" }
      }
    }
  },
  "watcher": {
    "ignore": [
      "my-profile",
      "log",
      "auth.json",
      "bot.config.json",
      "temp",
      ".temp-data",
      "coverage",
      "**/*.mhtml"
    ]
  }
}
