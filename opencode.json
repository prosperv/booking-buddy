{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "node-debugger": {
      "type": "local",
      "command": ["npx", "-y", "@jaenster/node-debugger-mcp"],
      "enabled": true
    }
  },
  "watcher": {
    "ignore": [
      "my-profile",
      "log",
      "auth.json",
      "bot.config.json",
      "temp",
      ".temp-data",
      "coverage",
      "**/*.mhtml"
    ]
  }
}
