{
    "name": "court-sign-up",
    "version": "0.1.0",
    "private": true,
    "main": "dist/index.js",
    "scripts": {
        "build": "tsc",
        "typecheck": "tsc --noEmit -p tsconfig.check.json",
        "start": "npx tsx examples/usage.ts",
        "dev": "tsc -w",
        "test": "vitest run",
        "test:unit": "vitest run --exclude \"**/functional/**\"",
        "test:functional": "vitest run test/functional bot/test/functional",
        "test:watch": "vitest watch",
        "test:coverage": "vitest run --coverage",
        "playwright:install": "npx playwright install chromium"
    },
    "dependencies": {
        "dayjs": "^1.11.21",
        "googleapis": "^178.0.0",
        "pino": "^10.3.1",
        "playwright": "^1.62.1"
    },
    "devDependencies": {
        "@types/node": "^26.1.2",
        "@vitest/coverage-v8": "^4.1.11",
        "tsx": "^4.23.12",
        "typescript": "^7.0.2",
        "typescript-js": "npm:typescript@^6.0.3",
        "typescript-language-server": "^5.3.0",
        "vitest": "^4.1.10"
    },
    "engines": {
        "node": ">=20"
    }
}
