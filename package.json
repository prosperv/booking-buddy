{
    "name": "court-sign-up",
    "version": "0.1.0",
    "private": true,
    "main": "dist/index.js",
    "scripts": {
        "build": "tsc",
        "start": "npx tsx examples/usage.ts",
        "dev": "tsc -w",
        "test": "vitest run",
        "test:unit": "vitest run --exclude \"**/functional/**\"",
        "test:functional": "vitest run test/functional bot/test/functional",
        "test:watch": "vitest watch",
        "test:coverage": "vitest run --coverage",
        "playwright:install": "npx playwright install chromium"
    },
    "dependencies": {
        "dayjs": "^1.11.21",
        "playwright": "^1.62.1"
    },
    "devDependencies": {
        "@types/node": "^26.1.2",
        "tsx": "^4.23.12",
        "typescript": "^7.0.2",
        "vitest": "^4.1.10"
    },
    "engines": {
        "node": ">=20"
    }
}
